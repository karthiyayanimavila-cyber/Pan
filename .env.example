# Telegram credentials from my.telegram.org and @BotFather.
API_ID=
API_HASH=
BOT_TOKEN=

# Comma-separated numeric owner IDs.
OWNER_IDS=

BOT_NAME=Pan
SUPPORT_CHAT=
UPDATE_CHANNEL=
START_IMAGE=

# Optional Emilia-style persistence services.
MONGO_URL=
MONGO_DB=pan
