# Create a bot with @BotFather and keep this secret.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to upload/manage the catalog.
ADMIN_IDS=

# Optional: @channelusername or numeric channel ID. The bot must be an admin there.
TARGET_CHANNEL_ID=

DB_PATH=data/panbot.sqlite3
RUNTIME_DIR=.runtime
PORT=8080
POLL_TIMEOUT=30
POLL_STALE_SECONDS=90
RESTART_BACKOFF_SECONDS=5
USE_DRAFTS=true

# Optional Pyrofork MTProto bridge. Disabled by default.
# Use only an account and source chats you control or are authorized to use.
ENABLE_PYROFORK=false
PYRO_API_ID=
PYRO_API_HASH=
PYRO_SESSION_NAME=pan_mtproto
PYRO_SOURCE_CHAT_IDS=
