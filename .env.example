# Runtime/watchdog.
WORKDIR=data/sessions
RUNTIME_DIR=.runtime
PORT=8080
HEARTBEAT_SECONDS=15
POLL_STALE_SECONDS=90
RESTART_BACKOFF_SECONDS=5
LOG_LEVEL=INFO
